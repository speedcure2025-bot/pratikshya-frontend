# ============================================================
# PRATIKSHYA FASHON FRONTEND — Environment Variables (Phase 6)
# Copy this file to .env and adjust. Nothing here is a secret.
# ============================================================

# --- API origin ---
# Leave as the default in development: requests stay relative and the Vite
# dev server proxies /api to http://localhost:8000 (see vite.config.js).
# Never hardcode a localhost URL into product data or media references.
VITE_API_BASE=/api/v1

# --- Media (Phase 6) ---
# Application-level media URL prefix served by the backend, mounted under
# VITE_API_BASE's parent. Must match the backend's API_V1_PREFIX +
# MEDIA_URL_PREFIX. Change it only if the backend mount changes.
VITE_MEDIA_URL_PREFIX=/api/v1/media/objects

# Origin that canonical media URLs resolve against.
#   (empty)                    → same origin; /api is proxied in development
#   https://cdn.example.com    → every media request goes to the CDN
# The backend already returns absolute URLs when MEDIA_CDN_BASE_URL is set on
# its side, so this is only needed when media is served from a different
# origin than the app shell.
VITE_MEDIA_ORIGIN=
